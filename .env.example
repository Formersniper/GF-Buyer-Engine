# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE: System of record for PostgreSQL database & persistence.
# Client-safe anon credentials (Used by frontend and backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / CLI Supabase credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SCOUT: Python public enrichment adapter configuration
SCOUT_PATH="./scout"
SCOUT_API_URL="http://localhost:8000"

# VOICE: Provider-neutral telephony / voice AI configuration
VOICE_PROVIDER="generic"
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=

