# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: System of record for PostgreSQL database & persistence.
# Client-safe anon credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only Supabase Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SCOUT: Python public enrichment adapter configuration
SCOUT_PATH="./scout"
SCOUT_API_URL="http://localhost:8000"

# VOICE: Provider-neutral telephony / voice AI configuration
VOICE_PROVIDER="generic"
VOICE_API_KEY="your-voice-api-key"
VOICE_WEBHOOK_SECRET="your-webhook-secret"

