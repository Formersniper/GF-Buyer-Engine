# NODE_ENV: Application environment tier: "production" | "development" | "test"
NODE_ENV="development"

# APP_URL: The canonical URL where this application is hosted (HTTPS required in production).
APP_URL=

# CORS_ALLOWED_ORIGINS: Comma-separated list of approved browser origins (no wildcard in production).
CORS_ALLOWED_ORIGINS=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# SUPABASE: System of record for PostgreSQL database & persistence.
# Client-safe anon credentials (Used by frontend and backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / CLI Supabase credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SCOUT: Python public enrichment adapter configuration
SCOUT_PATH="./scout"
SCOUT_API_URL="http://localhost:8000"

# VOICE: Telephony & Voice Agents Configuration
VOICE_MODE="MOCK" # Set to "REAL" for live outbound calls
VOICE_PROVIDER="sarvam" # Default provider: "sarvam" | "mock"
VOICE_WEBHOOK_SECRET=

# Phase 12.1 — Final Production Voice Authorization Contract
# CRITICAL SECURITY INVARIANTS:
# - "false" is the safe default for all voice enablement flags.
# - The presence of provider credentials (e.g. SARVAM_API_KEY) DOES NOT authorize calls.
# - Production outbound calling requires explicit VOICE_PRODUCTION_ENABLED="true".
# - VOICE_GLOBAL_KILL_SWITCH="true" immediately halts all outbound voice calls regardless of enablement.
VOICE_PRODUCTION_ENABLED="false"
VOICE_GLOBAL_KILL_SWITCH="false"
VOICE_REAL_PROVIDER_ALLOWLIST="sarvam"

# Phase 12.2 — Production Voice Activation Readiness, Rollout & Cost Policy
VOICE_ROLLOUT_ENABLED="false"
VOICE_ROLLOUT_PERCENTAGE="0"
VOICE_MAX_REAL_CALLS_PER_TENANT="0"
VOICE_MAX_REAL_CALLS_GLOBAL="0"
VOICE_MAX_CALL_DURATION_SECONDS="300"
VOICE_MAX_CALL_COST_INR="50"
VOICE_MAX_DAILY_COST_INR_PER_TENANT="1000"
VOICE_MAX_MONTHLY_COST_INR_PER_TENANT="25000"

# SARVAM VOICE AGENTS (Server-Side Secrets only)
SARVAM_API_KEY=
SARVAM_BASE_URL="https://apps.sarvam.ai"
SARVAM_ORG_ID="01a074ea-647b-7549-9a87-cb4a09a65faa"
SARVAM_WORKSPACE_ID="01a074ea-6481-766d-a3f3-c42aef343735"
SARVAM_AGENT_ID="Growthforge-ae0789e1-56b8"
SARVAM_AGENT_VERSION="2"
SARVAM_CONNECTION_ID="0174b928-7c-cdaf00f5-ff9a"
SARVAM_AGENT_PHONE_NUMBER="+918064266255"

# PHASE 8A.8: RATE LIMITING, CONCURRENCY & COST CONTROLS
RATE_LIMIT_ENABLED=true
GLOBAL_REQUESTS_PER_MINUTE=600
TENANT_REQUESTS_PER_MINUTE=120
MAX_SARVAM_CALLS_PER_TENANT_PER_HOUR=25
MAX_SARVAM_CALLS_PER_TENANT_PER_DAY=100
MAX_GEMINI_OPS_PER_TENANT_PER_HOUR=200
MAX_ENRICHMENTS_PER_TENANT_PER_HOUR=100
MAX_ACTIVE_SARVAM_CALL_DISPATCHES=10
MAX_ACTIVE_GEMINI_OPERATIONS=5
MAX_ACTIVE_SCOUT_OPERATIONS=5
IDEMPOTENCY_TTL_SECONDS=86400

# PHASE 8A.9: PII MASKING & OBSERVABILITY
LOG_LEVEL="INFO"
LOG_REDACTION_ENABLED=true
ENABLE_DEBUG_LOGS=false

