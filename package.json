{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:phase4a": "tsx tests/call-eligibility-verification.ts",
    "test:phase4a-live": "tsx tests/phase4a-live-validation.ts",
    "test:phase4b": "tsx tests/sarvam-unit-tests.ts",
    "test:phase4b-live": "tsx tests/phase4b-live-validation.ts",
    "test:phase5a": "tsx tests/phase5a-transcript-ingestion.ts",
    "test:phase5b": "tsx tests/phase5b-gemini-extraction.ts",
    "test:phase5c": "tsx tests/phase5c-buyer-qualification.ts",
    "test:phase5d": "tsx tests/phase5d-buyer-scoring.ts",
    "test:phase5e": "tsx tests/phase5e-project-matching.ts",
    "test:phase5f": "tsx tests/phase5f-broker-handoff.ts",
    "test:security:auth": "tsx tests/security-auth-foundation.ts",
    "test:security:ratelimit": "tsx tests/security-rate-limiting.ts",
    "test:security:concurrency": "tsx tests/security-concurrency.ts",
    "test:security:costs": "tsx tests/security-provider-cost-controls.ts",
    "test:security:pii": "tsx tests/security-pii-logging.ts",
    "test:security:redaction": "tsx tests/security-log-redaction.ts",
    "test:security:errors": "tsx tests/security-error-sanitization.ts",
    "test:security:correlation": "tsx tests/correlation-id.ts",
    "test:security:config": "tsx tests/security-production-config.ts",
    "test:security:boundary": "tsx tests/security-secret-boundary.ts",
    "test:security:cors": "tsx tests/security-cors-headers.ts",
    "test:persistence": "tsx tests/persistence-diagnostics.ts",
    "test:security:all": "npm run test:security:auth && npm run test:security:ratelimit && npm run test:security:concurrency && npm run test:security:costs && npm run test:security:pii && npm run test:security:redaction && npm run test:security:errors && npm run test:security:correlation && npm run test:security:config && npm run test:security:boundary && npm run test:security:cors && npm run test:persistence",
    "test:all": "export SKIP_INNER_RECURSION=true; npm run test:phase4a && npm run test:phase4b && npm run test:phase5a && npm run test:phase5b && npm run test:phase5c && npm run test:phase5d && npm run test:phase5e && npm run test:phase5f"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ts-morph": "^28.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
