    "test:phase4a-live": "tsx tests/phase4a-live-validation.ts",
    "test:phase4b": "tsx tests/sarvam-unit-tests.ts",
    "test:phase4b-live": "tsx tests/phase4b-live-validation.ts",
    "test:phase5a": "tsx tests/phase5a-transcript-ingestion.ts",
    "test:phase5b": "tsx tests/phase5b-gemini-extraction.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
